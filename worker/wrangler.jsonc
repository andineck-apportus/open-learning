{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "open-learning-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://andineck-apportus.github.io,http://localhost:5173",
