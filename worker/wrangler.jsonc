    "GOOGLE_REDIRECT_URI": "https://open-learning-ai.andineck.workers.dev/auth/google/callback"
  },
  "d1_databases": [{"binding":"AUTH_DB","database_name":"open-learning-auth","database_id":"03be99c4-9101-4f5b-8e45-aba484113144"}],
  "triggers": {"crons":["17 3 * * *"]}
}
